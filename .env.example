# SEO Data Fetcher — Environment Variables
# Copy this file to .env and fill in your credentials
# .env is already in .gitignore — never commit credentials

# ─── Google Service Account (for GSC + GA4) ───────────────────────────────
# Path to your Google Cloud service account JSON key file
# How to get it: Google Cloud Console → IAM & Admin → Service Accounts → Keys → Add Key → JSON
# Then add the service account email to each client's GSC property (Read access)
# and GA4 property (Viewer role)
GOOGLE_SERVICE_ACCOUNT_JSON=./credentials/service-account-key.json

# ─── DataForSEO (for AI visibility tracking) ──────────────────────────────
# Same credentials used by the DFS MCP server
# Get them at: https://dataforseo.com/
DATAFORSEO_LOGIN=your-email@example.com
DATAFORSEO_PASSWORD=your-api-password

# ─── OpenRouter (for AI-powered recommendations, existing project) ─────────
OPENROUTER_API_KEY=sk-or-v1-your-key-here
DEFAULT_MODEL=google/gemini-2.0-flash-001

# --- Bright Data (AI visibility, task 1.6) ---
# Account Settings > API tokens. Passed as an Authorization: Bearer header.
# Verified 2026-08-18 against docs.brightdata.com.
# A valid token is not enough: requests route through a ZONE, and an account
# with no zone fails the scrape call with a misleading 400 "Customer is not
# active". Run `python scripts/brightdata.py` to check before a monthly run.
BRIGHTDATA_API_TOKEN=
