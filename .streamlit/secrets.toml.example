# Ultimate SEO Auditor - Secrets Configuration
# Copy this file to secrets.toml and fill in your API credentials

# DataForSEO API (optional - for backlink and competitor analysis)
# Get credentials at: https://dataforseo.com/
DATAFORSEO_LOGIN = "your-email@example.com"
DATAFORSEO_PASSWORD = "your-api-password"

# OpenRouter API (required - for AI-powered recommendations)
# Get API key at: https://openrouter.ai/
OPENROUTER_API_KEY = "sk-or-v1-your-key-here"

# Default LLM Model (optional)
# Options: anthropic/claude-3.5-sonnet, openai/gpt-4o, google/gemini-pro
DEFAULT_MODEL = "anthropic/claude-3.5-sonnet"
